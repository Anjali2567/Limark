# Pre-push validation - runs before code is pushed to remote
# This ensures code quality and prevents breaking changes

echo "🔍 Running pre-push checks..."
echo ""

# 1. Type checking
echo "📝 Type checking..."
pnpm run typecheck || {
  echo "❌ Type check failed. Please fix type errors before pushing."
  exit 1
}

# 2. Linting (strict mode - no warnings allowed)
echo "🔧 Linting..."
pnpm run lint:strict || {
  echo "❌ Linting failed. Please fix linting errors before pushing."
  exit 1
}

