{
  "name": "leadplus-intelligence",
  "version": "1.0.0",
  "description": "LeadPlus Intelligence Layer - Database and Intelligence Foundation",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "start:debug": "tsx watch --inspect src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts --quiet",
    "lint:fix": "eslint src --ext .ts --fix --quiet",
    "lint:strict": "eslint src --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit --project tsconfig.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs mongodb",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:seed": "tsx src/db/seed.ts",
    "db:shell": "docker-compose exec mongodb mongosh leadplus_intelligence",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d && sleep 3",
    "test:db:down": "docker-compose -f docker-compose.test.yml down",
    "test:db:reset": "docker-compose -f docker-compose.test.yml down && docker-compose -f docker-compose.test.yml up -d && sleep 3",
    "test:db:logs": "docker-compose -f docker-compose.test.yml logs test-db",
    "enrich:account": "tsx src/cli/enrich-account.ts",
    "enrich:contact": "tsx src/cli/enrich-contact.ts",
    "test": "pnpm test:db:up && vitest run && pnpm test:db:down",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest watch --config vitest.unit.config.ts",
    "test:integration": "pnpm test:db:up && vitest run --config vitest.integration.config.ts && pnpm test:db:down",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "pnpm test:db:up && vitest run --coverage && pnpm test:db:down",
    "test:coverage:unit": "vitest run --coverage --config vitest.unit.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && echo '✅ All checks passed!'",
    "push:check": "pnpm format:check && pnpm typecheck && pnpm lint:strict && pnpm test && echo '✅ Ready to push!'"
  },
  "keywords": [
    "intelligence",
    "leadplus",
    "database",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "mongodb": "^6.11.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.1.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  }
}
